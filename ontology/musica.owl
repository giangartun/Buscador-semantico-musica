</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Piano_Cola_Steinway">
  <rdf:type rdf:resource="#Instrumento_Teclado"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de teclado y cuerda percutida de máxima exigencia mecánica. Su sofisticado mecanismo de escape y su enorme tabla armónica permiten un control absoluto de los matices dinámicos, desde el pianissimo más delicado hasta la resonancia más abrumadora.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Primavera_Vivaldi">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Antonio_Vivaldi"/>
  <Onto:interpretadaPor rdf:resource="#Violin_Solista"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Clavecin_Doble"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Viola_Orquestal"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Violonchelo_ArcoTradicional"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/violin"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Clavecin_Doble">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
  <Onto:esActivado rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Teclado_Piano"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad_Acorde_7maDism"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Saxofon_Alto">
  <rdf:type rdf:resource="#Instrumento_VientoMadera"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de viento madera con boquilla de lengüeta simple y cuerpo cónico de latón. Su registro medio-agudo y su extraordinaria expresividad vocal lo hacen protagonista tanto en orquestas contemporáneas como en la música popular.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Saxofon_Tenor">
  <rdf:type rdf:resource="#Instrumento_VientoMadera"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Miembro de la familia de los saxofones con un registro más grave e imponente. Su sonoridad robusta y aterciopelada es un pilar fundamental para los solos melódicos y la base de los ensambles modernos.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sergei_Rachmaninoff">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor, pianista y director de orquesta ruso del período post-romántico. Su estilo se caracteriza por un profundo lirismo melancólico, armonías densas y texturas de una extrema dificultad técnica, diseñadas para explotar toda la sonoridad del piano moderno.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sinfonia_5_Beethoven">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Ludwig_van_Beethoven"/>
  <Onto:interpretadaPor rdf:resource="#Corno_Frances"/>
  <Onto:interpretadaPor rdf:resource="#Fagot"/>
  <Onto:interpretadaPor rdf:resource="#Trombon"/>
  <Onto:interpretadaPor rdf:resource="#Trompeta"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Aerofono_DobleCana"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Contrabajo_Sinfonico"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Timbal_Orquestal"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Viola_Orquestal"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Violonchelo_ArcoTradicional"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/clarinete"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/flauta"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/violin"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Trombon">
  <rdf:type rdf:resource="#Instrumento_VientoMetal"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de viento metal que utiliza una vara telescópica deslizable para modificar la longitud del tubo y alterar la afinación. Su sonido es potente y es el único de la familia capaz de realizar glissandos puros y continuos.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Trompeta">
  <rdf:type rdf:resource="#Instrumento_VientoMetal"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">El instrumento más agudo de la familia de viento metal, accionado por válvulas o pistones. Su timbre brillante y direccional le otorga un papel dominante en fanfarrias sinfónicas, pasajes heroicos y melodías principales.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sonata_Claro_de_Luna">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Ludwig_van_Beethoven"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Piano_Cola_Steinway"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tocata_y_Fuga_Re_Menor">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Johann_Sebastian_Bach"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Organo_Tubos"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Organo_Tubos">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
  <Onto:esActivado rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Teclado_Piano"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad_Acorde_7maDism"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tuba">
  <rdf:type rdf:resource="#Instrumento_VientoMetal"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">El instrumento de viento metal más grande y grave de la orquesta. Utiliza un complejo sistema de pistones o válvulas para proporcionar el soporte armónico y rítmico fundamental, sosteniendo todo el peso sonoro de la sección de metales.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#s_sinte_jupiter">
  <rdf:type rdf:resource="#Instrumento_Electronico"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sintetizador polifónico analógico clásico. Conocido por sus densas capas de múltiples osciladores, filtros cálidos y su capacidad para crear texturas orquestales electrónicas y atmósferas envolventes.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#s_sinte_moog">
  <rdf:type rdf:resource="#Instrumento_Electronico"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sintetizador analógico monofónico legendario. Revolucionó la música moderna gracias a su diseño de control por voltaje, produciendo frecuencias graves profundas y solos de una contundencia electrónica inigualable.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#s_sintetizador_analogico">
  <rdf:type rdf:resource="#Instrumento_Electronico"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento electrofónico que genera sonido a través de circuitos analógicos. Modela la onda sonora mediante la manipulación de frecuencias y voltajes, permitiendo la creación infinita de timbres artificiales desde cero.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Aerofono_Andino">
