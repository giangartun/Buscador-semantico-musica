<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/arpa">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento armónico de cuerda pulsada de marco triangular. Produce el sonido mediante la vibración de cuerdas al ser pellizcadas con los dedos, aportando texturas arpegiadas, glissandos fluidos y acordes etéreos a cualquier ensamble.</descripcion>
  <Onto:extremidades rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</Onto:extremidades>
  <Onto:polifonia rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</Onto:polifonia>
</owl:NamedIndividual>

