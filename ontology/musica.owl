  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuerda frotada</Onto:oscilador>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Violin_ModulacionFisica_2">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuerda frotada</Onto:oscilador>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibrafono_Pro">
  <rdf:type rdf:resource="#Instrumento_Percusion"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Vibrafono_AlturaDeterminada"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento electroacústico de percusión con láminas de aluminio y pedal de sustain. Se distingue por su motor eléctrico que hace girar discos dentro de los tubos resonadores, generando su inconfundible efecto de vibrato continuo, fundamental en ensambles de jazz y música moderna.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Viola_ArcoTradicional">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Viola_CrinCaballo"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Violin_ModulacionFisica_2"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de cuerda frotada de registro intermedio, afinado una quinta más grave que el violín. Su timbre oscuro y cálido actúa como el tejido armónico conector entre los violines y los violonchelos.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Violin_ArcoTradicional">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Violin_CrinCaballo"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Violin_ModulacionFisica_1"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de cuerda frotada enfocado en la técnica clásica de arco con cerdas de crin. La fricción sostenida y controlada sobre las cuerdas permite un dominio absoluto del sustain, el fraseo dinámico y las articulaciones complejas exigidas en el repertorio de cámara y sinfónico estándar.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Violin_Stradivarius">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
