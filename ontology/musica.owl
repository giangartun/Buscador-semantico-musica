  <Onto:ambito rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multifonico</Onto:ambito>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cimbalum_CuerdaPercutida">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_4"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento tradicional compuesto por una gran caja de resonancia trapezoidal. Se ejecuta golpeando las cuerdas directamente con macillos manuales, generando un timbre folclórico muy resonante, utilizado frecuentemente en la música de Europa del Este y en ensambles contemporáneos.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_4">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuerda percutida</Onto:oscilador>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Clavicordio_CuerdaPercutida">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_3"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de teclado histórico donde las cuerdas son percutidas por pequeñas cuñas de metal llamadas tangentes. Destaca por ser el único instrumento de teclado antiguo que permite al ejecutante aplicar un sutil vibrato mecánico (Bebung) y ligeras variaciones dinámicas directas.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_3">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuerda percutida</Onto:oscilador>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Clavija_Afinacion">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Control"/>
  <Onto:accion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Doble escape</Onto:accion>
  <Onto:ambito rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grave adicional</Onto:ambito>
  <Onto:tipo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boehm</Onto:tipo>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Concierto_Oboe_Mozart">
