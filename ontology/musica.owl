  <Onto:titulo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">El Vuelo del Moscardón</Onto:titulo>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Xilofono_Orquestal">
  <rdf:type rdf:resource="#Instrumento_Percusion"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Xilofono_AlturaDeterminada"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de percusión formado por láminas de madera gruesa afinadas cromáticamente. Percutido con baquetas duras, ofrece un sonido seco, incisivo y de muy corta duración (sin resonadores prolongados), perfecto para articulaciones rápidas, esqueletos rítmicos y melodías muy definidas.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/acento">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Articulacion"/>
