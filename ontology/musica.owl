<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Timbal_Sinfonico_2">
  <rdf:type rdf:resource="#Instrumento_Percusion"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Timbal2_ParcheNatural"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Timbal2_ParcheNatural"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Complemento indispensable en el set orquestal moderno. Al estar afinado a una frecuencia distinta al timbal principal, expande el rango tonal del ejecutante, permitiendo rápidos cambios armónicos y sosteniendo la estructura tonal exigida en composiciones desde el período clásico al contemporáneo.</descripcion>
</owl:NamedIndividual>

