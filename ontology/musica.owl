  <Onto:transposicion rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</Onto:transposicion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ludwig_van_Beethoven">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor y pianista alemán, figura de transición vital entre las épocas Clásica y Romántica. Su obra sinfónica y sus sonatas redefinieron la música occidental, marcando un antes y un después en la intensidad emocional y la complejidad arquitectónica.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Organo_Tubos">
  <rdf:type rdf:resource="#Instrumento_Teclado"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Majestuoso instrumento de teclado y aerófono. Controla el paso del aire a presión a través de conjuntos de tubos de diferentes registros mediante múltiples teclados manuales y un pedalier.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Oxygene_Pt4">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Jean_Michel_Jarre"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/s_sinte_moog"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/s_sintetizador_analogico"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/s_sinte_moog">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Salida"/>
  <Onto:filtroResonancia rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</Onto:filtroResonancia>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/s_sintetizador_analogico">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Salida"/>
