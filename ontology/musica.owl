  <Onto:volumen rdf:datatype="http://www.w3.org/2001/XMLSchema#float">18.0</Onto:volumen>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Timbal_ParcheNatural">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Membrana de parche natural</Onto:oscilador>
</owl:NamedIndividual>

