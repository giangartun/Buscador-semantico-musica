<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/mandolina">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de cuerda pulsada de la familia del laúd, provisto de una caja de resonancia abombada y cuerdas dobles. Su técnica característica de trémolo rápido con plectro permite sostener notas melódicas continuas con un timbre excepcionalmente brillante e incisivo.</descripcion>
  <Onto:articulacion rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.7</Onto:articulacion>
</owl:NamedIndividual>

