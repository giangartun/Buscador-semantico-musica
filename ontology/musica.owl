<owl:Class rdf:about="#Obra">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Acordeon_Cromatico">
  <rdf:type rdf:resource="#Instrumento_Teclado"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento aerófono portátil con fuelle y lengüetas libres. Posee teclados en ambos lados, permitiendo al ejecutante interpretar melodías complejas y acompañamientos armónicos simultáneamente.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Antonio_Vivaldi">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor y violinista italiano del período Barroco, figura clave en el desarrollo del concierto solista. Su dominio de la composición para cuerdas quedó inmortalizado en su famosa serie de conciertos "Las cuatro estaciones".</descripcion>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ressource musicale historique très pertinente de DBpedia.</descripcion>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recurso histórico musical de alta relevancia en DBpedia.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Arpa_Concierto">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gran instrumento de cuerda pulsada con un complejo sistema de pedales. Ofrece una inmensa riqueza armónica y es fundamental para los efectos de glissando y texturas etéreas en la orquesta.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Astor_Piazzolla">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandoneonista y compositor argentino, creador del "Nuevo Tango". Revolucionó el género tradicional al incorporar elementos del jazz y la música clásica, utilizando instrumentaciones innovadoras que incluían guitarras eléctricas, pianos y cuerdas.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Bajo_Electrico_Fender">
  <rdf:type rdf:resource="#Instrumento_Electronico"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento electrofónico de cuerda pulsada fundamental en la instrumentación moderna. Proporciona la base armónica y rítmica gracias a sus pastillas magnéticas que convierten la vibración de las cuerdas en señal eléctrica.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Capricho_24">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Niccolo_Paganini"/>
  <Onto:interpretadaPor rdf:resource="#Violin_Solista"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Niccolo_Paganini">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor y violinista virtuoso italiano del Romanticismo. Su técnica deslumbrante, velocidad extrema y el uso innovador de armónicos y pizzicatos establecieron un nuevo estándar definitivo para la ejecución del violín solista.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Violin_Solista">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Miembro de la familia de cuerdas clásicas destacado por su configuración y proyección acústica superior, destinado a la ejecución de melodías principales y pasajes de extrema virtuosidad técnica.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Celesta_Orquestal">
  <rdf:type rdf:resource="#Instrumento_Teclado"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de teclado percutido que, mediante martillos cubiertos de fieltro, golpea láminas metálicas sobre cajas de resonancia. Produce un sonido cristalino y mágico inconfundible.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Concierto_Clarinete_K622">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Wolfgang_Amadeus_Mozart"/>
  <Onto:interpretadaPor rdf:resource="#Corno_Frances"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Viola_Orquestal"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Violonchelo_ArcoTradicional"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/clarinete"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/flauta"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/violin"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Wolfgang_Amadeus_Mozart">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor austriaco del período Clásico y niño prodigio inigualable. Su prolífica obra abarca todos los géneros posibles de su época con una perfección formal, elegancia y brillantez melódica que siguen siendo la base del repertorio académico.</descripcion>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wolfgang Amadeus Mozart (27 January 1756 – 5 December 1791), baptised as Johannes Chrysostomus</descripcion>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recurso histórico musical de alta relevancia en DBpedia.</descripcion>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ressource musicale historique très pertinente de DBpedia.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Corno_Frances">
  <rdf:type rdf:resource="#Instrumento_VientoMetal"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de viento metal con tubo cónico enrollado y válvulas rotativas. Actúa como el puente tímbrico perfecto entre las familias de madera y metal gracias a su sonido cálido, redondo y majestuoso.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Viola_Orquestal">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad_CuerdaFrotada"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Violonchelo_ArcoTradicional">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Violonchelo_CrinCaballo"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Violin_ModulacionFisica_3"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de cuerda frotada de registro grave. Destaca por tener el rango tímbrico más cercano a la voz humana, siendo crucial tanto como instrumento solista, melódico y como bajo continuo.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/clarinete">
  <rdf:type rdf:resource="#Instrumento_VientoMadera"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de viento madera de lengüeta simple y tubo cilíndrico. Posee una extraordinaria agilidad técnica y un rango dinámico expansivo que abarca desde graves profundos hasta agudos penetrantes.</descripcion>
  <Onto:articulacion rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.5</Onto:articulacion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/flauta">
  <rdf:type rdf:resource="#Instrumento_VientoMadera"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de viento madera sin lengüeta que produce sonido por la fricción del aire contra un bisel. Su agilidad sobresaliente y tono brillante lideran frecuentemente la sección melódica superior de la orquesta.</descripcion>
  <Onto:familia rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vientoMadera</Onto:familia>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/violin">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de cuerda frotada de registro agudo. En conjunto, las secciones orquestales de primeros y segundos violines constituyen el núcleo melódico principal que guía la estructura de las obras sinfónicas.</descripcion>
  <Onto:articulacion rdf:datatype="http://www.w3.org/2001/XMLSchema#float">8.5</Onto:articulacion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad_CuerdaFrotada">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad"/>
  <Onto:tesitura rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Glissando continuo</Onto:tesitura>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Violonchelo_CrinCaballo">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
  <Onto:impedancia rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.6</Onto:impedancia>
  <Onto:volumen rdf:datatype="http://www.w3.org/2001/XMLSchema#float">9.0</Onto:volumen>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Violin_ModulacionFisica_3">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuerda frotada</Onto:oscilador>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Corno_Ingles">
  <rdf:type rdf:resource="#Instrumento_VientoMadera"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de viento madera de doble lengüeta, estrechamente emparentado con el oboe pero con registro más grave y campana piriforme. Destaca por su timbre profundamente melancólico.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#El_Cascanueces_Danza_Hada">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Pyotr_Ilyich_Tchaikovsky"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Aerofono_DobleCana"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Celesta_Orquestal"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/clarinete"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Pyotr_Ilyich_Tchaikovsky">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor ruso del período romántico, célebre por su inigualable talento melódico y su magistral orquestación sinfónica. Es el autor de algunos de los ballets más icónicos de la historia, integrando familias completas de instrumentos con un dramatismo único.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Aerofono_DobleCana">
  <rdf:type rdf:resource="#Instrumento_VientoMadera"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Aerofono_PresionMin_3"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de viento madera provisto de una lengüeta doble. Su sonido penetrante, expresivo y estable lo convierte en el estándar universal para la afinación de la orquesta sinfónica.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Celesta_Orquestal">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
  <Onto:esActivado rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Teclado_Piano"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad_Acorde_7maDism"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Aerofono_PresionMin_3">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Columna de aire</Onto:oscilador>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Teclado_Piano">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Control"/>
  <Onto:accion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mecanismo de percusión</Onto:accion>
  <Onto:teclas rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88</Onto:teclas>
  <Onto:tipo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boehm</Onto:tipo>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad_Acorde_7maDism">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad"/>
  <Onto:polifonia rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</Onto:polifonia>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Fagot">
  <rdf:type rdf:resource="#Instrumento_VientoMadera"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento grave de viento madera con lengüeta doble y un largo tubo plegado. Proporciona la base armónica de la sección de maderas, destacando por su tono oscuro, resonante y gran agilidad técnica.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Franz_Liszt">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor y pianista virtuoso húngaro del período romántico. Llevó la técnica del piano a niveles de exigencia sin precedentes, explorando al máximo los recursos acústicos del instrumento y creando el formato de poema sinfónico para orquesta.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Frederic_Chopin">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor y pianista virtuoso polaco-francés del Romanticismo. Su obra está dedicada casi en su totalidad al piano solo, destacando por una profunda expresividad, innovación armónica y una técnica brillante que redefinió el repertorio del instrumento.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Historia_del_Tango_Bordel">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Astor_Piazzolla"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/flauta"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/guitarra"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/guitarra">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento armónico de cuerda pulsada. Su inmensa versatilidad sonora le permite abarcar desde la polifonía de la música académica hasta ser el motor rítmico y armónico fundamental del pop y el rock.</descripcion>
  <Onto:extremidades rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</Onto:extremidades>
  <Onto:polifonia rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</Onto:polifonia>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Jean_Michel_Jarre">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor y productor francés, pionero mundial de la música electrónica. Es famoso por la integración masiva de sintetizadores analógicos, secuenciadores y tecnología electroacústica para crear paisajes sonoros complejos y vanguardistas.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Johann_Sebastian_Bach">
  <rdf:type rdf:resource="#Compositor"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compositor y organista alemán del período Barroco, considerado uno de los más grandes genios de la historia musical. Llevó a la cumbre el arte del contrapunto y la fuga, dejando una vasta obra estructuralmente perfecta para teclado, cuerdas y ensambles.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Lago_de_los_Cisnes">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Obra"/>
  <compuestaPor rdf:resource="#Pyotr_Ilyich_Tchaikovsky"/>
  <Onto:interpretadaPor rdf:resource="#Arpa_Concierto"/>
  <Onto:interpretadaPor rdf:resource="#Corno_Frances"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Aerofono_DobleCana"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Contrabajo_Sinfonico"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Timbal_Orquestal"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Viola_Orquestal"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Violonchelo_ArcoTradicional"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/flauta"/>
  <Onto:interpretadaPor rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/violin"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Contrabajo_Sinfonico">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Capacidad_CuerdaFrotada"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Timbal_Orquestal">
  <rdf:type rdf:resource="#Instrumento_Percusion"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Timbal_ParcheNatural"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Timbal_ParcheNatural"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de percusión de membrana afinable, compuesto por un gran cuenco de cobre y un sistema de tensión por pedales. Es el pilar rítmico y armónico de la percusión sinfónica, capaz de generar un bajo resonante y dramáticos crescendos mediante redobles.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo_Timbal_ParcheNatural">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Cuerpo"/>
