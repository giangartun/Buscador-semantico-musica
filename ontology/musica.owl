<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Piano_CuerdaPercutida_A">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_1"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instrumento de teclado equipado con una compleja acción mecánica donde macillos recubiertos de fieltro golpean las cuerdas. Su diseño permite una respuesta dinámica de altísima precisión, logrando desde ataques percusivos sumamente contundentes hasta texturas armónicas muy delicadas.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_1">
  <rdf:type rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion"/>
  <Onto:numeroOscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</Onto:numeroOscilador>
  <Onto:oscilador rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuerda percutida</Onto:oscilador>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Piano_CuerdaPercutida_B">
  <rdf:type rdf:resource="#Instrumento_Cuerda"/>
  <Onto:tienePropiedad rdf:resource="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_2"/>
  <descripcion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Variante de la familia de cuerdas percutidas con teclado, destacada por su arquitectura acústica integral. Su extensa tabla armónica y mecanismo de escape le otorgan la capacidad de sostener complejas polifonías y proyectar el sonido por encima de grandes densidades orquestales.</descripcion>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/gamerstorecbba/ontologies/2026/2/OntologiaMUS/Vibracion_Piano_SustainNatural_2">
